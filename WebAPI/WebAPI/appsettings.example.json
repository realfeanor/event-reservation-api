{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BaseDb": "Server=localhost;Database=EventReservation;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "CacheSettings": {
    "SlidingExpiration": 2
  },
  "SeatHold": {
    "DurationMinutes": 10
  },
  "ReservationExpiration": {
    "PollingIntervalSeconds": 60,
    "BatchSize": 100
  },
  "ElasticSearchConfig": {
    "ConnectionString": "http://localhost:9200",
    "Password": "",
    "UserName": ""
  },
  "MailSettings": {
    "AuthenticationRequired": false,
    "DkimPrivateKey": "",
    "DkimSelector": "",
    "DomainName": "localhost",
    "Password": "",
    "Port": 25,
    "SenderEmail": "noreply@localhost",
    "SenderFullName": "Event Reservation API",
    "Server": "localhost",
    "UserName": ""
  },
  "CloudinaryAccount": {
    "ApiKey": "",
    "ApiSecret": "",
    "Cloud": ""
  },
  "SeriLogConfigurations": {
    "FileLogConfiguration": {
      "FolderPath": "logs"
    }
  },
  "TokenOptions": {
    "AccessTokenExpiration": 10,
    "Audience": "event-reservation-api",
    "Issuer": "event-reservation-api",
    "RefreshTokenTTL": 2,
    "SecurityKey": "replace-with-a-development-secret-of-at-least-64-characters-before-running"
  },
  "WebAPIConfiguration": {
    "APIDomain": "http://localhost:5278/api",
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5278"
    ]
  },
  "AmazonConfiguration": {
    "AccessKey": "",
    "SecretKey": ""
  }
}
